{
  "name": "we-do",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "CLOUDFLARE_ENV=${CLOUDFLARE_ENV:-local} CI=1 wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "CLOUDFLARE_ENV=${CLOUDFLARE_ENV:-local} tsx src/db/seed-local.ts",
    "db:seed:local:bootstrap": "CLOUDFLARE_ENV=${CLOUDFLARE_ENV:-local} tsx src/db/seed-cloudflare.ts --local --bootstrap",
    "db:seed:preview": "tsx src/db/seed-cloudflare.ts --preview",
    "db:seed:remote": "tsx src/db/seed-cloudflare.ts --remote",
    "deploy": "vite build && wrangler deploy --config dist/we_do/wrangler.json --env=\"\"",
    "deploy:check": "tsx scripts/validate-cloudflare-deploy.ts",
    "deploy:prod": "npm run deploy:check && npm run deploy",
    "predev": "npm run setup:local",
    "dev": "CLOUDFLARE_ENV=${CLOUDFLARE_ENV:-local} vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:local": "npm run db:migrate:local && npm run db:seed:local:bootstrap",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:struct": "vitest run tests/structural",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  }
}
